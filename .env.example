# Web3Forms access key (web3forms.com). In CI it comes from the FORMSSECRET repository secret.
PUBLIC_WEB3FORMS_KEY=

# Google Sheet with booked dates, published as CSV (File > Share > Publish to web > CSV).
# In CI it comes from the BOOKED_DATES_CSV_URL repository secret. Empty = demo dates in dev.
PUBLIC_BOOKED_DATES_CSV_URL=
