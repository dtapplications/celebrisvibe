---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, ROUTES } from '../data/site';
import { href } from '../lib/urls';

const current = Astro.url.pathname;
const isCurrent = (path: string) => current === href(path);
---
<header class="header" data-header>
  <a href={href(ROUTES.home)} class="home" aria-label="Celebris Vibe - начало">
    <Logo height={58} label="" class="header-logo" />
  </a>

  <nav class="nav" aria-label="Основно меню">
    {NAV.slice(1).map(([path, label]) => (
      <a href={href(path)} aria-current={isCurrent(path) ? 'page' : undefined}>{label}</a>
    ))}
  </nav>

  <button type="button" class="round theme" data-theme-toggle aria-label="Смени темата">
    <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4.5" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
    </svg>
    <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
  </button>

  <a href={href(ROUTES.contact)} class="btn btn-primary btn-sm cta">Запази дата</a>

  <button type="button" class="round menu-btn" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Отвори менюто">
    <Icon name="menu" size={20} class="i-open" />
    <Icon name="close" size={20} class="i-close" />
  </button>

  <div class="menu" id="mobile-menu" hidden>
    {NAV.map(([path, label]) => (
      <a href={href(path)} aria-current={isCurrent(path) ? 'page' : undefined}>{label}</a>
    ))}
    <a href={href(ROUTES.contact)} class="btn btn-primary">Запази дата</a>
  </div>
</header>

<style>
  .header {
    position: sticky; top: 12px; z-index: 30;
    margin: 12px clamp(12px, 2vw, 24px) 0;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 6px 8px 6px 16px; border-radius: 999px;
    background: var(--header-bg); backdrop-filter: blur(14px); border: 1px solid var(--line);
  }
  .home { flex: none; display: flex; }
  .nav { display: flex; gap: 2px; flex: 1 1 auto; min-width: 0; justify-content: center; }
  .nav a {
    flex: none; padding: 8px 12px; border-radius: 999px; white-space: nowrap;
    font-size: 16px; color: var(--body); transition: color 200ms;
  }
  .nav a:hover { color: var(--ink); }
  .nav a[aria-current='page'] {
    color: var(--ink); font-weight: 600; text-decoration: underline;
    text-decoration-color: var(--gold); text-decoration-thickness: 2px; text-underline-offset: 7px;
  }
  .round {
    flex: none; width: 40px; height: 40px; border-radius: 999px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  .theme { border: 1px solid var(--edge); background: transparent; color: var(--ink); }
  :global([data-theme='light']) .sun, :global(:root:not([data-theme='light'])) .moon { display: none; }
  .cta { flex: none; }
  .menu-btn { display: none; border: none; background: var(--ink); color: var(--paper); }
  .menu-btn :global(.i-close), .header.is-open .menu-btn :global(.i-open) { display: none; }
  .header.is-open .menu-btn :global(.i-close) { display: block; }

  .menu {
    position: absolute; top: calc(100% + 8px); left: 0; right: 0;
    display: flex; flex-direction: column; gap: 2px; padding: 10px;
    background: var(--paper); border: 1px solid var(--edge); border-radius: 24px;
    box-shadow: 0 24px 48px -24px rgba(0,0,0,0.35);
  }
  .menu[hidden] { display: none; }
  .menu a:not(.btn) {
    padding: 14px 16px; border-radius: 12px; border-left: 3px solid transparent;
    font-size: 17px; color: var(--body);
  }
  .menu a[aria-current='page'] { background: var(--card); border-left-color: var(--gold); color: var(--ink); font-weight: 600; }
  .menu .btn { margin-top: 6px; }

  @media (max-width: 900px) {
    .nav, .cta { display: none; }
    .menu-btn { display: flex; }
    .theme { margin-left: auto; }
  }
  @media (max-width: 640px) {
    .header :global(.header-logo) { height: 48px; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const menu = header.querySelector<HTMLElement>('#mobile-menu')!;
  const menuBtn = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;

  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    header.classList.toggle('is-open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Затвори менюто' : 'Отвори менюто');
  };
  menuBtn.addEventListener('click', () => setMenu(menu.hidden));
  document.addEventListener('click', e => { if (!menu.hidden && !header.contains(e.target as Node)) setMenu(false); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !menu.hidden) { setMenu(false); menuBtn.focus(); } });

  const themeBtn = header.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const syncThemeLabel = () => {
    themeBtn.title = document.documentElement.dataset.theme === 'light' ? 'Тъмна тема' : 'Светла тема';
  };
  themeBtn.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('cv-theme', next); } catch {}
    syncThemeLabel();
  });
  syncThemeLabel();
</script>
