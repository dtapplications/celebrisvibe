---
import Logo from './Logo.astro';
import { NAV, ROUTES, SITE_NAME, SLOGAN, SOCIAL } from '../data/site';
import { href } from '../lib/urls';

const current = Astro.url.pathname;
---
<footer class="footer">
  <div class="top">
    <Logo height={100} />
    <nav aria-label="Долно меню">
      {NAV.map(([path, label]) => (
        <a href={href(path)} aria-current={current === href(path) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
  </div>
  <div class="bottom">
    <div class="legal">
      <span class="slogan">{SLOGAN}</span>
      <span>© {new Date().getFullYear()} {SITE_NAME}</span>
      <a href={href(ROUTES.privacy)} class="underline">Политика за поверителност</a>
    </div>
    <div class="social">
      <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
        </svg>
      </a>
      <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.25-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21h2.9z" />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer { padding: 56px var(--pad-x) 32px; border-top: 1px solid var(--line); }
  .top { display: flex; justify-content: space-between; gap: 32px; flex-wrap: wrap; align-items: flex-start; }
  nav { display: flex; gap: 4px 8px; flex-wrap: wrap; max-width: 480px; }
  nav a { padding: 6px 10px; font-size: 15px; color: var(--body); transition: color 200ms; }
  nav a:hover { color: var(--ink); }
  nav a[aria-current='page'] {
    color: var(--ink); font-weight: 600; text-decoration: underline;
    text-decoration-color: var(--gold); text-decoration-thickness: 2px; text-underline-offset: 7px;
  }
  .bottom { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-top: 40px; font-size: 14px; color: var(--muted); }
  .legal { display: flex; gap: 6px 20px; flex-wrap: wrap; align-items: center; }
  .slogan { flex-basis: 100%; }
  .underline { text-decoration: underline; text-underline-offset: 3px; }
  .social { display: flex; gap: 10px; }
  .social a {
    width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--edge); color: var(--ink);
    display: flex; align-items: center; justify-content: center; transition: color 200ms, border-color 200ms;
  }
  .social a:hover { color: var(--gold); border-color: var(--gold); }
</style>
