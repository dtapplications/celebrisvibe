---
import Icon from './Icon.astro';
import { ESTIMATE, ESTIMATE_DEFAULTS as D, ESTIMATE_TYPES, GUEST_OPTIONS, ROUTES, estimatePrice } from '../data/site';
import { href } from '../lib/urls';
---
<div class="wrap">
  <form class="card est" data-estimator onsubmit="return false">
    <div class="fields">
      <div class="display heading">Изчисли ориентировъчна цена</div>

      <fieldset>
        <legend class="field-label">Вид събитие</legend>
        <div class="choices">
          {ESTIMATE_TYPES.map(([key, label]) => (
            <label class="choice"><input type="radio" name="type" value={key} checked={key === D.type} /><span>{label}</span></label>
          ))}
        </div>
      </fieldset>

      <div>
        <label for="est-hours" class="field-label hours-label">
          <span>Продължителност</span>
          <span class="hours-value"><output name="hoursOut" for="est-hours">{D.hours}</output> часа</span>
        </label>
        {/* The last step stands for "more than 5 hours" */}
        <input id="est-hours" type="range" name="hours" min={ESTIMATE.minHours} max={ESTIMATE.maxHours + 1} step="1" value={D.hours} />
        <p class="hours-note" data-long-note hidden>Над {ESTIMATE.maxHours} часа — допълнителното време се уточнява в персоналната оферта.</p>
      </div>

      <fieldset>
        <legend class="field-label">Гости</legend>
        <div class="choices">
          {GUEST_OPTIONS.map(g => (
            <label class="choice"><input type="radio" name="guests" value={g} checked={g === D.guests} /><span>{g}</span></label>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend class="field-label">Допълнителни услуги</legend>
        <div class="choices">
          <label class="choice choice-box"><input type="checkbox" name="sound" checked={D.sound} /><span>Озвучаване</span></label>
          <label class="choice choice-box"><input type="checkbox" name="host" checked={D.host} /><span>Водещ</span></label>
          <label class="choice choice-box"><input type="checkbox" name="lights" checked={D.lights} /><span>Осветление</span></label>
        </div>
      </fieldset>
    </div>

    <div class="total">
      <div aria-live="polite">
        <div class="total-label">Ориентировъчно от</div>
        <div class="display total-value">€<span data-total>{estimatePrice(D)}</span><span class="star">*</span></div>
      </div>
      <a href={href(ROUTES.contact)} class="btn btn-paper btn-sm" data-estimate-link>
        Получи точна оферта <Icon name="arrowRight" size={16} />
      </a>
    </div>
  </form>
  <p class="note">
    * Посочената цена е автоматично изчислен ориентир и не представлява окончателна оферта. Крайната цена зависи от мястото, продължителността, програмата, необходимото оборудване и допълнителните услуги. След запитване ще получиш персонална оферта до един работен ден.
  </p>
</div>

<style>
  .wrap { width: 100%; max-width: 580px; justify-self: center; }
  .est { overflow: hidden; box-shadow: 0 30px 60px -36px rgba(0,0,0,0.45); }
  .fields { padding: 28px; display: flex; flex-direction: column; gap: 22px; }
  .heading { font-size: 24px; letter-spacing: -0.02em; }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend { padding: 0; }
  .field-label { font-size: 13px; }
  .hours-label { display: flex; justify-content: space-between; }
  .hours-value { color: var(--ink); font-weight: 600; }
  input[type='range'] { width: 100%; accent-color: var(--gold); cursor: pointer; }
  .hours-note { margin: 8px 0 0; font-size: 13px; color: var(--muted); }
  .choice span { padding: 9px 14px; border-color: var(--edge); }

  .total {
    padding: 22px 28px; background: var(--ink); color: var(--paper);
    display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
  }
  .total-label { font-size: 13px; color: var(--band-gold); }
  .total-value { font-weight: 700; font-size: 40px; letter-spacing: -0.03em; line-height: 1.05; }
  .star { color: var(--band-gold); }
  .note { margin: 14px 4px 0; font-size: 13px; line-height: 1.55; color: var(--muted); }
</style>

<script>
  import { ESTIMATE, ESTIMATE_TYPES, estimatePrice } from '../data/site';
  import { ESTIMATE_PREFIX } from '../lib/draft';

  const form = document.querySelector<HTMLFormElement>('[data-estimator]');
  if (form) {
    const total = form.querySelector<HTMLElement>('[data-total]')!;
    const hoursOut = form.querySelector<HTMLOutputElement>('output')!;
    const link = form.querySelector<HTMLAnchorElement>('[data-estimate-link]')!;
    const longNote = form.querySelector<HTMLElement>('[data-long-note]')!;

    const update = () => {
      const f = new FormData(form);
      const input = {
        type: String(f.get('type')),
        hours: Number(f.get('hours')),
        guests: String(f.get('guests')),
        sound: f.has('sound'),
        host: f.has('host'),
        lights: f.has('lights'),
      };
      const price = estimatePrice(input);
      const long = input.hours > ESTIMATE.maxHours;
      const hoursText = long ? `над ${ESTIMATE.maxHours}` : String(input.hours);
      total.textContent = String(price);
      hoursOut.value = long ? `${ESTIMATE.maxHours}+` : String(input.hours);
      longNote.hidden = !long;
      // Carry the selection into the contact form
      link.dataset.draft = JSON.stringify({
        mode: 'inquiry',
        type: ESTIMATE_TYPES.find(([k]) => k === input.type)![2],
        guests: input.guests,
        services: ['DJ', ...(input.sound ? ['Озвучаване'] : []), ...(input.host ? ['Водещ'] : []), ...(input.lights ? ['Осветление'] : [])],
        estimate: `${ESTIMATE_PREFIX}: от €${price}, ${hoursText} часа`,
      });
    };
    form.addEventListener('input', update);
    update();
  }
</script>
