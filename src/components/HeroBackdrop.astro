---
// Decorative stage beams, bokeh and an equalizer behind page heroes. Pure CSS animation.
// The parent needs position: relative and overflow: hidden (the .hero class does this).
const BEAMS = [
  { left: '-6%', width: '34%', opacity: 0.22, dur: 9, delay: 0 },
  { left: '22%', width: '26%', opacity: 0.14, dur: 12, delay: -4 },
  { left: '52%', width: '30%', opacity: 0.18, dur: 10, delay: -7 },
  { left: '78%', width: '28%', opacity: 0.2, dur: 11, delay: -2 },
];
const BOKEH = [
  { x: '8%', y: '22%', size: 22, o: 0.5, dur: 7, delay: 0 },
  { x: '18%', y: '70%', size: 12, o: 0.6, dur: 6, delay: -2 },
  { x: '31%', y: '12%', size: 34, o: 0.35, dur: 9, delay: -5 },
  { x: '42%', y: '58%', size: 16, o: 0.5, dur: 8, delay: -1 },
  { x: '49%', y: '30%', size: 10, o: 0.7, dur: 5, delay: -3 },
  { x: '58%', y: '80%', size: 28, o: 0.4, dur: 10, delay: -6 },
  { x: '66%', y: '18%', size: 14, o: 0.6, dur: 7, delay: -4 },
  { x: '74%', y: '48%', size: 40, o: 0.3, dur: 11, delay: -8 },
  { x: '86%', y: '26%', size: 18, o: 0.55, dur: 6, delay: -1 },
  { x: '92%', y: '68%', size: 24, o: 0.45, dur: 9, delay: -7 },
  { x: '3%', y: '88%', size: 30, o: 0.35, dur: 10, delay: -3 },
  { x: '36%', y: '90%', size: 12, o: 0.6, dur: 6, delay: -5 },
];
const EQ = Array.from({ length: 220 }, (_, i) => ({ dur: 0.6 + ((i * 37) % 11) / 10, delay: ((i % 7) * -0.17).toFixed(2) }));
---
<div class="backdrop" aria-hidden="true">
  {BEAMS.map(b => (
    <div class="beam" style={`left:${b.left};width:${b.width};--o:${b.opacity};animation-duration:${b.dur}s;animation-delay:${b.delay}s`}><div /></div>
  ))}
  {BOKEH.map(d => (
    <span class="dot" style={`left:${d.x};top:${d.y};width:${d.size}px;height:${d.size}px;--o:${d.o};animation-duration:${d.dur}s;animation-delay:${d.delay}s`} />
  ))}
  <div class="eq">
    {EQ.map(e => <span style={`animation-duration:${e.dur}s;animation-delay:${e.delay}s`} />)}
  </div>
</div>

<style>
  .backdrop { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .beam {
    position: absolute; top: -12%; height: 125%; transform-origin: 50% 0;
    opacity: calc(var(--o) * var(--fx-beam)); filter: blur(28px); mix-blend-mode: var(--fx-blend);
    animation: beam 10s ease-in-out infinite alternate;
  }
  .beam > div {
    width: 100%; height: 100%;
    clip-path: polygon(44% 0, 56% 0, 100% 100%, 0 100%);
    background: linear-gradient(to bottom, var(--fx-color), transparent 70%);
  }
  .dot {
    position: absolute; border-radius: 50%; opacity: 0; mix-blend-mode: var(--fx-blend);
    background: radial-gradient(circle, var(--fx-color) 0%, transparent 70%);
    animation: bokeh 8s ease-in-out infinite;
  }
  .eq {
    position: absolute; left: 0; right: 0; bottom: 0; height: 26px; overflow: hidden;
    display: flex; align-items: flex-end; justify-content: center; gap: 5px;
    opacity: var(--fx-eq);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
  }
  .eq span {
    flex: none; width: 3px; height: 100%; border-radius: 2px; background: var(--fx-color);
    transform-origin: bottom; transform: scaleY(0.15);
    animation: eq 1s ease-in-out infinite alternate;
  }

  @keyframes beam { from { transform: rotate(-14deg); } to { transform: rotate(14deg); } }
  @keyframes bokeh {
    0%, 100% { opacity: 0; transform: translateY(0) scale(0.8); }
    50% { opacity: min(1, calc(var(--o) * var(--fx-dot))); transform: translateY(-28px) scale(1); }
  }
  @keyframes eq { from { transform: scaleY(0.12); } to { transform: scaleY(1); } }

  @media (max-width: 640px) {
    .beam:nth-of-type(2n) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot { opacity: 0.25 !important; }
  }
</style>
