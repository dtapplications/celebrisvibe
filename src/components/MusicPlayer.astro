---
import Icon from './Icon.astro';

const MUSIC_PLAYER = {
  title: 'Celebris Vibe Radio',
  subtitle: 'Музика за настроението',
  playlistId: 'RDMM',
  youtubeMusicUrl: 'https://music.youtube.com/',
};
const embedUrl = `https://www.youtube-nocookie.com/embed/videoseries?list=${MUSIC_PLAYER.playlistId}&autoplay=1&rel=0`;
---

<aside class="music-player" data-music-player aria-label="Музикален плейър">
  <button type="button" class="player-trigger" data-player-trigger aria-expanded="false" aria-controls="music-player-panel">
    <span class="disc" aria-hidden="true">
      <Icon name="music" size={18} />
    </span>
    <span class="trigger-copy">
      <strong>{MUSIC_PLAYER.title}</strong>
      <small>{MUSIC_PLAYER.subtitle}</small>
    </span>
    <span class="equalizer" aria-hidden="true"><i></i><i></i><i></i></span>
  </button>

  <section class="player-panel" id="music-player-panel" data-player-panel hidden aria-label="Celebris Vibe Radio">
    <header class="panel-head">
      <div>
        <span class="eyebrow">YouTube Music</span>
        <h2>{MUSIC_PLAYER.title}</h2>
      </div>
      <button type="button" class="close" data-player-close aria-label="Затвори плейъра">
        <Icon name="close" size={18} />
      </button>
    </header>
    <div class="frame-wrap">
      <iframe
        data-player-frame
        title="YouTube Music радио"
        src=""
        data-src={embedUrl}
        loading="lazy"
        allow="autoplay; encrypted-media; picture-in-picture"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
    <a class="youtube-link" href={MUSIC_PLAYER.youtubeMusicUrl} target="_blank" rel="noopener noreferrer">
      Отвори в YouTube Music
      <Icon name="arrowRight" size={16} />
    </a>
  </section>
</aside>

<style>
  .music-player {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 40;
  }
  .player-trigger {
    width: 238px;
    min-height: 68px;
    display: grid;
    grid-template-columns: 44px 1fr 22px;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--header-bg);
    backdrop-filter: blur(16px);
    box-shadow: 0 18px 50px -24px rgba(0,0,0,0.55);
    color: var(--ink);
    text-align: left;
    cursor: pointer;
  }
  .player-trigger:hover { border-color: var(--gold); }
  .disc {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--frame);
    border-radius: 50%;
    color: var(--paper);
    background: linear-gradient(135deg, var(--gold), var(--frame));
  }
  .trigger-copy { display: flex; flex-direction: column; min-width: 0; }
  .trigger-copy strong { font-family: var(--font-display); font-size: 14px; }
  .trigger-copy small { margin-top: 2px; color: var(--muted); font-size: 12px; }
  .equalizer { height: 18px; display: flex; align-items: end; justify-content: center; gap: 3px; }
  .equalizer i { width: 3px; border-radius: 3px; background: var(--gold); animation: cvpulse 900ms ease-in-out infinite alternate; }
  .equalizer i:nth-child(1) { height: 8px; }
  .equalizer i:nth-child(2) { height: 16px; animation-delay: -300ms; }
  .equalizer i:nth-child(3) { height: 11px; animation-delay: -600ms; }
  .player-panel {
    position: absolute;
    right: 0;
    bottom: 78px;
    width: min(380px, calc(100vw - 32px));
    overflow: hidden;
    border: 1px solid var(--edge);
    border-radius: 24px;
    background: var(--paper);
    box-shadow: 0 28px 70px -30px rgba(0,0,0,0.7);
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 16px 14px;
  }
  .panel-head h2 { margin: 4px 0 0; font-family: var(--font-display); font-size: 18px; letter-spacing: -0.02em; }
  .eyebrow { color: var(--eyebrow); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; }
  .close {
    width: 36px;
    height: 36px;
    flex: none;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
  }
  .frame-wrap { aspect-ratio: 16 / 9; background: var(--card); }
  iframe { width: 100%; height: 100%; border: 0; display: block; }
  .youtube-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    color: var(--ink);
    font-size: 14px;
    font-weight: 500;
  }
  .youtube-link:hover { color: var(--gold); }

  @keyframes cvpulse {
    from { transform: scaleY(0.45); opacity: 0.55; }
    to { transform: scaleY(1); opacity: 1; }
  }

  @media (max-width: 640px) {
    .music-player { right: 12px; bottom: 12px; }
    .player-trigger { width: 62px; grid-template-columns: 44px; min-height: 62px; }
    .trigger-copy, .equalizer { display: none; }
    .player-panel { bottom: 72px; }
  }
</style>

<script>
  const player = document.querySelector<HTMLElement>('[data-music-player]')!;
  const trigger = player.querySelector<HTMLButtonElement>('[data-player-trigger]')!;
  const panel = player.querySelector<HTMLElement>('[data-player-panel]')!;
  const close = player.querySelector<HTMLButtonElement>('[data-player-close]')!;
  const frame = player.querySelector<HTMLIFrameElement>('[data-player-frame]')!;

  const setOpen = (open: boolean) => {
    panel.hidden = !open;
    trigger.setAttribute('aria-expanded', String(open));
    if (open) {
      if (!frame.hasAttribute('src') || frame.getAttribute('src') === '') frame.src = frame.dataset.src || '';
    } else {
      frame.removeAttribute('src');
    }
  };

  trigger.addEventListener('click', () => setOpen(panel.hidden));
  close.addEventListener('click', () => {
    setOpen(false);
    trigger.focus();
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && !panel.hidden) {
      setOpen(false);
      trigger.focus();
    }
  });
</script>
