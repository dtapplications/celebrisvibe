---
import { Image } from 'astro:assets';
import { EXTRAS, ROUTES } from '../data/site';
import { href } from '../lib/urls';
import { photo } from '../lib/photos';
---
<div>
  <div class="section-head">
    <div>
      <h2 class="h2">Допълнителни опции</h2>
      <p class="sub">Добави към всеки пакет - сами или чрез нашата партньорска мрежа.</p>
    </div>
    <a href={href(ROUTES.prices)} class="text-link">Виж цените</a>
  </div>
  <div class="grid">
    {EXTRAS.map(e => (
      <article class="card extra lift">
        <div class="photo-frame pic">
          <Image src={photo(e.photo)} alt={e.title} widths={[360, 560, 800]} sizes="(min-width: 1400px) 20vw, (min-width: 700px) 45vw, 100vw" />
          <span class="badge">{e.tag}</span>
        </div>
        <div class="body">
          <h3 class="display title">{e.title}</h3>
          <p class="desc">{e.desc}</p>
          <div class="actions">
            <a href={href(ROUTES.prices)} class="text-link text-link-sm">Към цените</a>
            <a href={href(ROUTES.contact)} class="btn btn-primary add" data-extra={e.title} data-draft={JSON.stringify({ mode: 'inquiry', extra: e.title })}>
              Добави към запитване
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 20px; }
  /* Five extras in one row on wide screens, so none is left alone on a row */
  @media (min-width: 1400px) { .grid { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .extra { border-radius: 32px; padding: 10px; display: flex; flex-direction: column; }
  .pic { aspect-ratio: 4 / 3; border-radius: 24px; }
  .badge { position: absolute; top: 12px; right: 12px; padding: 6px 12px; border-radius: 999px; background: var(--paper); font-size: 13px; color: var(--ink); }
  .body { padding: 20px 14px 10px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .title { margin: 0; font-size: 26px; line-height: 1.05; }
  .desc { margin: 0; font-size: 16px; font-weight: 300; line-height: 1.5; color: var(--body); }
  .actions { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: auto; padding-top: 12px; }
  .add { padding: 11px 18px; font-size: 14px; border-color: var(--ink); }
  .add.is-added { background: transparent; color: var(--ink); }
</style>

<script>
  import { readDraft } from '../lib/draft';

  // Mark extras already in the visitor's enquiry
  const note = readDraft().note ?? '';
  document.querySelectorAll<HTMLElement>('[data-extra]').forEach(btn => {
    if (note.includes(btn.dataset.extra!)) {
      btn.classList.add('is-added');
      btn.textContent = 'Добавено ✓';
    }
  });
</script>
