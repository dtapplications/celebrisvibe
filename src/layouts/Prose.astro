---
import Base from './Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Icon from '../components/Icon.astro';
import { ROUTES } from '../data/site';
import { href } from '../lib/urls';

// Layout for MDX text pages (privacy policy and similar). Frontmatter becomes `frontmatter`.
interface Props {
  frontmatter: { title: string; description: string; eyebrow: string; updated?: string };
}
const { title, description, eyebrow, updated } = Astro.props.frontmatter;
---
<Base title={title} description={description}>
  <article class="page-top">
    <div class="prose">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h1 class="h1 title">{title}</h1>
      {updated && <p class="updated">Последна актуализация: {updated}</p>}
      <slot />
      <a href={`${href(ROUTES.contact)}#cv-form`} class="btn btn-primary btn-sm back"><Icon name="arrowLeft" /> Обратно към формата</a>
    </div>
  </article>
</Base>

<style>
  .prose { max-width: 780px; }
  .title { margin-top: 24px; font-size: clamp(36px, 4.6vw, 72px); line-height: 1; }
  .updated { margin: 20px 0 0; font-size: 14px; color: var(--muted); }
  .prose :global(h2) { margin: 40px 0 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em; font-size: 26px; line-height: 1.15; }
  .prose :global(p:not(.updated)) { margin: 12px 0 0; font-size: 17px; font-weight: 300; line-height: 1.65; color: var(--body); }
  .prose :global(p a) { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
  .back { margin-top: 48px; }
</style>
