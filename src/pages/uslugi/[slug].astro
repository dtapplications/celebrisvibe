---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { ROUTES, SITE_NAME } from '../../data/site';
import { SERVICES, serviceUrl, type Service } from '../../data/services';
import { abs, href } from '../../lib/urls';
import { photo } from '../../lib/photos';

export async function getStaticPaths() {
  return SERVICES.map((service, index) => ({ params: { slug: service.slug }, props: { service, index } }));
}

const { service: s, index } = Astro.props as { service: Service; index: number };
const others = SERVICES.filter(o => o.slug !== s.slug);
const url = abs(Astro.site, serviceUrl(s.slug));

const schema = [
  {
    '@type': 'Service',
    '@id': `${url}#service`,
    name: s.title,
    serviceType: s.title,
    description: s.description,
    url,
    provider: { '@id': abs(Astro.site, '#organization') },
    areaServed: { '@type': 'Country', name: 'България' },
    audience: { '@type': 'Audience', audienceType: s.fits.join(', ') },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Начало', item: abs(Astro.site) },
      { '@type': 'ListItem', position: 2, name: 'Услуги', item: abs(Astro.site, ROUTES.services) },
      { '@type': 'ListItem', position: 3, name: s.title, item: url },
    ],
  },
];
---
<Base title={s.seoTitle} description={s.description} og={s.slug} schema={schema}>
  <article class="page-top">
    <nav aria-label="Навигация" class="crumbs">
      <a href={href(ROUTES.services)}>Услуги</a> <span aria-hidden="true">/</span> <span aria-current="page">{s.title}</span>
    </nav>

    <div class="split top">
      <div>
        <div class="num">0{index + 1}</div>
        <h1 class="h2-sm" style="margin-top:10px">{s.title}</h1>
        <p class="lead-text">{s.description}</p>

        <h2 class="label">Какво включва</h2>
        <ul class="check-list">{s.includes.map(item => <li>{item}</li>)}</ul>

        <h2 class="label" style="margin-top:28px">Подходящо за</h2>
        <div class="tags" style="margin-top:10px">{s.fits.map(f => <span class="tag">{f}</span>)}</div>

        <div class="btn-row">
          <a href={href(ROUTES.contact)} data-draft={JSON.stringify({ mode: 'inquiry', services: s.formServices })} class="btn btn-primary btn-sm">Запитване за {s.title}</a>
          <a href={href(ROUTES.prices)} class="btn btn-outline btn-sm">Цени</a>
        </div>
      </div>

      <figure class="photo-frame figure">
        <Image src={photo(s.photo)} alt={`${s.title} - ${SITE_NAME}`} widths={[480, 800, 1200]} sizes="(min-width: 1000px) 50vw, 100vw" loading="eager" fetchpriority="high" />
        <figcaption><blockquote class="display">{s.quote}</blockquote></figcaption>
      </figure>
    </div>
  </article>

  <section class="section">
    <h2 class="h2-sm">Акценти</h2>
    <div class="highlights">
      {s.highlights.map(h => (
        <div class="card highlight">
          <div class="photo-frame pic">
            <Image src={photo(h.photo)} alt={h.title} widths={[360, 560, 800]} sizes="(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 100vw" />
          </div>
          <div class="hl-body">
            <div class="tags">{h.occasions.map(o => <span class="tag">{o}</span>)}</div>
            <h3 class="display hl-title">{h.title}</h3>
            <p class="hl-desc">{h.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <h2 class="h2-sm stack-gap">Други услуги</h2>
    <div class="others">
      {others.map(o => (
        <a href={href(serviceUrl(o.slug))} class="card other lift">
          <span>
            <span class="display other-title">{o.title}</span>
            <span class="other-desc">{o.intro}</span>
          </span>
          <span class="go"><Icon name="arrowRight" /></span>
        </a>
      ))}
    </div>

    <CtaBand actions={[
      { label: 'Виж цените', path: ROUTES.prices },
      { label: 'Провери датата', path: ROUTES.contact, draft: { mode: 'inquiry', services: s.formServices }, primary: true },
    ]}>Свободна ли е датата ти?</CtaBand>
  </section>
</Base>

<style>
  .crumbs { font-size: 14px; color: var(--muted); margin-bottom: 32px; }
  .crumbs a { text-decoration: underline; text-underline-offset: 3px; }
  .crumbs a:hover { color: var(--gold); }
  .top { align-items: start; }
  .num { font-family: var(--font-display); font-weight: 700; font-size: 15px; color: var(--gold); }
  .lead-text { margin: 24px 0 0; font-size: 19px; font-weight: 300; line-height: 1.6; color: var(--body); }
  .label { margin: 32px 0 0; font-size: 14px; font-weight: 500; color: var(--muted); }

  .figure { margin: 0; aspect-ratio: 4 / 3; border-radius: 32px; }
  figcaption {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: clamp(56px, 7vw, 96px) clamp(24px, 3vw, 40px) clamp(24px, 3vw, 36px);
    background: linear-gradient(transparent, rgba(10,10,12,0.55) 45%, rgba(10,10,12,0.9));
  }
  blockquote {
    margin: 0; padding-left: 20px; border-left: 3px solid #c9ad78; letter-spacing: -0.02em;
    font-size: clamp(20px, 2vw, 28px); line-height: 1.25; color: #f2f1ec; text-wrap: balance;
  }

  .highlights { margin-top: 36px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 20px; }
  .highlight { border-radius: 32px; padding: 10px; display: flex; flex-direction: column; }
  .pic { aspect-ratio: 4 / 3; border-radius: 24px; }
  .hl-body { padding: 20px 14px 14px; display: flex; flex-direction: column; gap: 10px; }
  .hl-body .tag { padding: 5px 11px; font-size: 13px; }
  .hl-title { margin: 0; font-size: 26px; line-height: 1.05; }
  .hl-desc { margin: 0; font-size: 16px; font-weight: 300; line-height: 1.5; color: var(--body); }

  .others { margin-top: 36px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .other { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 28px; }
  .other-title { display: block; font-size: 28px; line-height: 1.1; }
  .other-desc { display: block; margin-top: 8px; font-size: 16px; font-weight: 300; line-height: 1.5; color: var(--body); }
  .go { flex-shrink: 0; width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--edge); display: flex; align-items: center; justify-content: center; }
  .other:hover .go { background: var(--gold); border-color: var(--gold); color: #1b1d22; }
</style>
