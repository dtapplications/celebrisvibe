---
import App from '../components/App';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Celebris Vibe</title>
  <link rel="icon" href={`${base}/assets/celebris-logo.png`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: 'Jost', Helvetica, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    a { text-decoration: none; }
    input, select, textarea, button { font-family: inherit; }
    button:focus-visible,
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible {
      outline: 2px solid #8a6d3b;
      outline-offset: 3px;
    }
    @keyframes cvspin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; animation: none !important; }
    }
    /* Hover effects driven by CSS custom properties set on the wrapper */
    .cv-btn-primary:hover {
      background: var(--cv-gold) !important;
    }
    .cv-card:hover {
      transform: translateY(-4px) !important;
      box-shadow: 0 24px 48px -28px rgba(0,0,0,0.35) !important;
    }
    .cv-event-card:hover {
      transform: translateY(-6px) !important;
      box-shadow: 0 30px 60px -30px rgba(0,0,0,0.4) !important;
    }
    .cv-event-row:hover {
      transform: translateY(-2px) !important;
    }

    /* ── Responsive overrides (inline styles need !important) ── */
    @media (max-width: 900px) {
      .cv-nav, .cv-header-cta { display: none !important; }
      .cv-menu-btn { display: flex !important; }
      .cv-theme-btn { margin-left: auto; }
    }
    @media (max-width: 640px) {
      .cv-header-logo { height: 40px !important; }
      .cv-plan-tabs { justify-self: stretch !important; flex-wrap: nowrap !important; }
      .cv-plan-tabs > button { flex: 1; padding: 10px 6px !important; font-size: 14px !important; }
      .cv-event-row {
        grid-template-columns: 84px minmax(0,1fr) !important;
        gap: 16px !important;
        padding: 14px !important;
      }
      .cv-event-date { padding: 12px 6px !important; }
      .cv-event-action {
        grid-column: 1 / -1;
        flex-direction: row !important;
        justify-content: space-between;
        align-items: center !important;
      }
      .cv-next-event { right: 0 !important; bottom: 0 !important; padding: 12px 16px !important; }
    }
  </style>
</head>
<body>
  <App client:load />
</body>
</html>
