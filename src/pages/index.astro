---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import ServiceShowcase from '../components/ServiceShowcase.astro';
import Occasions from '../components/Occasions.astro';
import Extras from '../components/Extras.astro';
import { ROUTES, SITE_NAME } from '../data/site';
import { abs, href } from '../lib/urls';
import { photo } from '../lib/photos';

const website = {
  '@type': 'WebSite',
  '@id': abs(Astro.site, '#website'),
  url: abs(Astro.site),
  name: SITE_NAME,
  inLanguage: 'bg',
  publisher: { '@id': abs(Astro.site, '#organization') },
};

// Links from the old single-page site (/#services, and /#contact in printed QR codes)
const legacy = { services: ROUTES.services, prices: ROUTES.prices, contact: ROUTES.contact, privacy: ROUTES.privacy };
const legacyMap = Object.fromEntries(Object.entries(legacy).map(([k, v]) => [k, href(v)]));
---
<Base
  title="Celebris Vibe - DJ, водещ, озвучаване и осветление за събития"
  fullTitle
  og="home"
  description="DJ, водещ, професионално озвучаване и осветление за сватби, частни и корпоративни събития — цялостно решение за твоя повод. Провери свободна дата онлайн."
  schema={[website]}
>
  <script slot="head" is:inline define:vars={{ legacyMap }}>
    var target = legacyMap[location.hash.slice(1)];
    if (target) location.replace(target);
  </script>

  <section class="hero page-top split">
    <HeroBackdrop />
    <div>
      <Eyebrow>DJ · Водещ · Озвучаване · Осветление</Eyebrow>
      <h1 class="h1" style="margin-top:24px">Създаваме настроение.<br />Празнуваме живота.</h1>
      <p class="lead" style="max-width:500px">
        DJ, водещ, професионално озвучаване и осветление за сватби, частни и корпоративни събития — цялостно решение за твоя повод.
      </p>
      <div class="btn-row">
        <a href={href(ROUTES.contact)} data-draft='{"mode":"inquiry"}' class="btn btn-primary">Провери свободна дата</a>
        <a href={href(ROUTES.contact)} data-draft='{"mode":"call"}' class="btn btn-outline">Свържи се с нас</a>
      </div>
    </div>

    <div class="visual">
      <div class="photo-frame circle">
        <Picture
          src={photo('hero')}
          alt="Сватбено парти на дансинга"
          formats={['avif', 'webp']}
          widths={[320, 480, 720, 960]}
          sizes="(min-width: 1000px) 460px, 82vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="ring" aria-hidden="true"><span /></div>
      <a href={href(ROUTES.contact)} data-draft='{"mode":"inquiry"}' class="badge">
        <span class="display badge-title">Провери свободна дата</span>
        <span class="badge-sub">Предварителна проверка за секунди</span>
      </a>
    </div>
  </section>

  <section style="padding: 0 clamp(12px,2vw,24px) clamp(64px,8vw,112px)">
    <ServiceShowcase />
  </section>

  <section class="section approach">
    <h2 class="h2-sm">Индивидуален подход към всяко събитие.</h2>
    <p class="sub">
      Усещаме хората, следваме настроението и съобразяваме музиката с енергията на вечерта. Подхождаме индивидуално към всеки повод, защото вярваме, че незабравимото събитие се изгражда с усет и внимание към детайла.
    </p>
  </section>

  <section class="section">
    <Occasions showServicesLink />
  </section>

  <section class="section">
    <Extras />
  </section>
</Base>

<style>
  .approach {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 24px clamp(32px, 5vw, 80px); align-items: end;
  }
  .approach .sub { margin: 0; font-size: 19px; line-height: 1.6; }
  .visual { position: relative; width: min(100%, 560px); aspect-ratio: 1; justify-self: center; }
  .circle { position: absolute; inset: 9%; border-radius: 50%; }
  .circle :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* The brush circle from the logo, cropped and slowly rotating around the photo */
  .ring { position: absolute; inset: 0; overflow: hidden; pointer-events: none; animation: cvspin 90s linear infinite; }
  .ring span {
    position: absolute; width: 273%; left: -86.8%; top: -72.2%; aspect-ratio: 2624 / 3142;
    background: var(--logo);
    -webkit-mask: url('/assets/celebris-logo-dark.svg') center / contain no-repeat;
    mask: url('/assets/celebris-logo-dark.svg') center / contain no-repeat;
  }
  .badge {
    position: absolute; right: -4px; bottom: 6%; display: flex; flex-direction: column; gap: 2px;
    padding: 16px 20px; background: var(--paper); border: 1px solid var(--line); border-radius: 20px;
    box-shadow: 0 24px 48px -24px rgba(0,0,0,0.35); color: var(--ink);
  }
  .badge-title { font-size: 22px; }
  .badge-sub { font-size: 14px; }
  @media (max-width: 640px) {
    .badge { right: 0; bottom: 0; padding: 12px 16px; }
  }
</style>
