---
import QRCode from 'qrcode';
import { abs, href } from '../lib/urls';
import { ROUTES } from '../data/site';
import SeoMeta from '../components/SeoMeta.astro';
import '@fontsource/jost/300.css';
import '@fontsource/jost/500.css';
import '@fontsource/onest/600.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const CONTACT_URL = abs(Astro.site, ROUTES.contact);
const qrSvg = await QRCode.toString(CONTACT_URL, {
  type: 'svg',
  margin: 2,
  width: 280,
  color: { dark: '#1b1d22', light: '#ffffff' },
});
---

<!DOCTYPE html>
<html lang="bg">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <SeoMeta
    title="Контакти - Celebris Vibe"
    description="Сканирай QR кода, за да отвориш формата за контакт на Celebris Vibe и да ни разкажеш за събитието си - DJ, водещ, озвучаване и осветление."
    og="qr"
  />
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      background: #f2f1ec;
      color: #1b1d22;
      font-family: 'Jost', Helvetica, sans-serif;
      -webkit-font-smoothing: antialiased;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 24px;
    }
    a { color: inherit; text-decoration: none; }
    .card {
      background: #fff;
      border-radius: 32px;
      padding: 48px 40px 40px;
      max-width: 440px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 28px;
      box-shadow: 0 32px 64px -24px rgba(27,29,34,0.18);
    }
    .logo { height: 52px; }
    .qr-wrap {
      background: #fff;
      border-radius: 20px;
      border: 1px solid #dad8d0;
      padding: 16px;
      line-height: 0;
    }
    .qr-wrap svg { display: block; }
    .label {
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .label-title {
      font-family: 'Onest', sans-serif;
      font-weight: 600;
      font-size: 26px;
      letter-spacing: -0.03em;
      line-height: 1.1;
    }
    .label-sub {
      font-size: 15px;
      font-weight: 300;
      color: #5d6068;
      line-height: 1.5;
    }
    .url {
      font-size: 12px;
      color: #9a9ca3;
      word-break: break-all;
      text-align: center;
    }
    .btn-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .btn {
      padding: 12px 22px;
      border-radius: 999px;
      font-family: 'Jost', sans-serif;
      font-size: 15px;
      font-weight: 500;
      cursor: pointer;
      border: 1px solid #1b1d22;
    }
    .btn-solid { background: #1b1d22; color: #f2f1ec; }
    .btn-outline { background: transparent; color: #1b1d22; }
    .btn-solid:hover { background: #8a6d3b; border-color: #8a6d3b; }
    .footer-note {
      margin-top: 8px;
      font-size: 13px;
      color: #9a9ca3;
      text-align: center;
    }
    @media print {
      body { background: #fff; padding: 0; }
      .card { box-shadow: none; border: none; padding: 24px; }
      .btn-row, .footer-note { display: none; }
    }
  </style>
</head>
<body>
  <div class="card">
    <img src={`${base}assets/celebris-logo-dark.png`} alt="Celebris Vibe" class="logo" />

    <div class="qr-wrap">
      <Fragment set:html={qrSvg} />
    </div>

    <div class="label">
      <div class="label-title">Планирай събитието си с нас</div>
      <div class="label-sub">Сканирай, за да отвориш формата за контакт<br />и ни разкажи за събитието си.</div>
    </div>

    <div class="url">{CONTACT_URL}</div>

    <div class="btn-row">
      <button class="btn btn-solid" onclick="window.print()">Принтирай / Запази като PDF</button>
      <a href={href(ROUTES.contact)} class="btn btn-outline">Отвори формата</a>
    </div>
  </div>

  <p class="footer-note">© 2026 Celebris Vibe · <a href={base}>celebrisvibe.com</a> · Създаваме Вайб, Честваме Живота.</p>
</body>
</html>
